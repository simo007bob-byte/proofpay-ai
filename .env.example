# This demo binds loopback only. Never commit actual PayPal secrets.
PORT=8777
HOST=127.0.0.1
# Use your own FREE PayPal Developer Sandbox app credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Pretrained local CPU AI runs by default; requires npm ci and one free ONNX model download.
AI_PROVIDER=EMBEDDINGS
# Optional OLLAMA provider: AI_PROVIDER=OLLAMA (no cloud API fallback).
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Data kept on the server; default: project/data/state.json (gitignored)
DATA_FILE=
